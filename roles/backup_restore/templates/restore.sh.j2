#!/bin/bash
# Generated by day0-infra-build roles/backup_restore - edits here will
# be overwritten on the next Ansible run. Edit
# variables/play/backup_restore.yml and roles/backup_restore instead.
#
# Unified restore for every backup stream this project maintains. The
# whole point: never work out a path or a generation by hand at
# restore time - `list` shows what's actually available, everything
# else takes a name, not a path.
set -euo pipefail

POSTGRES_BACKUP_DIR="{{ postgres_backup_dir }}"
QNAP_SNAPSHOT_DIR="{{ qnap_snapshot_backup_dir }}"
CREDENTIALS_BACKUP_DIR="{{ credentials_backup_dir }}"
LOCAL_CREDENTIALS_DIR="{{ local_credentials_dir }}"

# name -> live QNAP export mount point, generated from
# qnap_snapshot_restore_targets so this list can never drift from what
# qnap_backup_dirs/qnap_snapshot actually manage.
declare -A RESTORE_TARGETS=(
{% for name, path in qnap_snapshot_restore_targets.items() %}
  [{{ name }}]="{{ path }}"
{% endfor %}
)

usage() {
  cat <<'USAGE'
restore.sh - unified restore for QNAP/cluster backups.

  restore.sh list                            Show everything restorable right now
  restore.sh postgres [db] [--dry-run]       Restore one db (default: all 7), newest generation
  restore.sh postgres <db> --to <scratch-db> Restore into a scratch db instead - safe test, no confirmation needed
  restore.sh sealed-secrets [--dry-run]      Stage the newest key backup onto local disk
  restore.sh qnap-data <source> [date] [--dry-run]
                                              Restore a QNAP export (default: newest generation)
  restore.sh qnap-data <source> --to <path>  Restore into a scratch path instead - safe test, no confirmation needed
  restore.sh ssh-keys [--dry-run]            Restore SSH private keys to ~/.ssh (needed before any QNAP-targeting play)
  restore.sh adhoc [--dry-run]               Apply manifests kept outside ArgoCD (day2-services/adhoc/)

Real restores (no --dry-run, no --to) ask for confirmation before
touching anything. Nothing here ever runs unattended or on a schedule.
USAGE
}

# --- discovery -------------------------------------------------------

# A single glob per directory listing, filtered afterward - not one ls
# call with several mixed .dump/.sql.gz patterns. Confirmed live
# 2026-08-12: ls (GNU) exits non-zero if ANY pattern in a multi-pattern
# call fails to match, even when others do (e.g. "globals" only ever
# has a .sql.gz, never a .dump) - with set -e + pipefail that silently
# killed the whole script. glob_list below is the one place that
# absorbs this; everything else calls through it.
glob_list() {
  # Lists a single glob pattern's matches, one per line, or nothing -
  # never a non-zero exit from a merely-empty match.
  compgen -G "$1" || true
}

# Excludes "globals" - it's role definitions, not a database, handled
# by its own dump_globals/restore_postgres_globals pass. A real "globals"
# database will never exist to collide with this.
postgres_db_names() {
  glob_list "$POSTGRES_BACKUP_DIR/daily/*" \
    | xargs -n1 basename \
    | sed -E 's/-[0-9]{4}-[0-9]{2}-[0-9]{2}\.(dump|sql\.gz)$//' \
    | grep -v '^globals$' \
    | sort -u
}

newest_postgres_file() {
  local db="$1" f
  f=$(glob_list "$POSTGRES_BACKUP_DIR/daily/$db-*" | sort -r | head -1)
  if [ -z "$f" ]; then
    f=$(glob_list "$POSTGRES_BACKUP_DIR/weekly/$db-*" | sort -r | head -1)
  fi
  if [ -z "$f" ]; then
    f=$(glob_list "$POSTGRES_BACKUP_DIR/monthly/$db-*" | sort -r | head -1)
  fi
  echo "$f"
}

postgres_generation_count() {
  local db="$1"
  {
    glob_list "$POSTGRES_BACKUP_DIR/daily/$db-*"
    glob_list "$POSTGRES_BACKUP_DIR/weekly/$db-*"
    glob_list "$POSTGRES_BACKUP_DIR/monthly/$db-*"
  } | wc -l
}

cmd_list() {
  echo "== Postgres databases (${POSTGRES_BACKUP_DIR}) =="
  local dbs
  dbs=$(postgres_db_names)
  if [ -z "$dbs" ]; then
    echo "  (none found - has postgres-backup ever run?)"
  else
    while IFS= read -r db; do
      local latest count
      latest=$(newest_postgres_file "$db")
      count=$(postgres_generation_count "$db")
      printf "  %-16s latest: %-32s generations: %s\n" "$db" "$(basename "$latest")" "$count"
    done <<< "$dbs"
  fi

  echo
  echo "== QNAP data snapshot (${QNAP_SNAPSHOT_DIR}) =="
  if [ ! -d "$QNAP_SNAPSHOT_DIR/daily" ]; then
    echo "  (none found - has the snapshot job ever run?)"
  else
    for src in "${!RESTORE_TARGETS[@]}"; do
      local newest
      newest=$(glob_list "$QNAP_SNAPSHOT_DIR/daily/*/$src" | sort -r | head -1)
      if [ -n "$newest" ]; then
        printf "  %-10s latest generation: %s\n" "$src" "$(basename "$(dirname "$newest")")"
      else
        printf "  %-10s (no generation contains this source)\n" "$src"
      fi
    done
    echo "  available dates:"
    ls -1t "$QNAP_SNAPSHOT_DIR/daily" 2>/dev/null | sed 's/^/    /'
  fi

  echo
  echo "== Sealed-secrets key (${CREDENTIALS_BACKUP_DIR}) =="
  local key
  key=$(glob_list "$CREDENTIALS_BACKUP_DIR/sealed-secrets-key-*.yaml" | sort -r | head -1)
  if [ -n "$key" ]; then
    echo "  latest: $(basename "$key")"
  else
    echo "  (none found)"
  fi
}

confirm() {
  local prompt="$1"
  read -r -p "$prompt Type 'yes' to proceed: " reply
  [ "$reply" = "yes" ]
}

# --- postgres ----------------------------------------------------------
# Runs pg_restore inside the cluster via a one-off Job, not on
# k8smaster directly - pg_restore/psql aren't installed on this host
# (confirmed live 2026-08-12), and piping a dump through `kubectl exec`
# stdin has a known silent-truncation bug on larger streams in this
# project (see project memory kubectl_exec_stdin_truncation) - both
# ruled out. The Job reuses the exact same hostPath-mount pattern
# postgres-backup already uses to WRITE these files, just pointed at
# reading one back - no new access path, no file transfer needed.
restore_one_postgres_db() {
  local db="$1" dryrun="$2" target="${3:-$db}"
  local file
  file=$(newest_postgres_file "$db")
  if [ -z "$file" ]; then
    echo "No backup found for database '$db'" >&2
    return 1
  fi
  local relpath="${file#"$POSTGRES_BACKUP_DIR"/}"
  echo "[*] $db <- $relpath"
  if [ "$target" != "$db" ]; then
    echo "    -> restoring into scratch db '$target', not the live '$db'"
  fi
  if [ "$dryrun" = "1" ]; then
    echo "    (dry-run) would run a Job: pg_restore --clean --if-exists -d $target /mnt/backup/active_backup/postgres/$relpath"
    return 0
  fi

  # When targeting a scratch db (--to), (re)create it first - pg_restore
  # populates an existing database, it doesn't create one, and Postgres
  # has no CREATE DATABASE IF NOT EXISTS - so drop-if-exists first makes
  # repeat test runs against the same scratch name idempotent.
  local precreate=""
  if [ "$target" != "$db" ]; then
    precreate="dropdb --if-exists -h postgres.postgres.svc.cluster.local -U postgres '${target}' && createdb -h postgres.postgres.svc.cluster.local -U postgres -O postgres '${target}' &&"
  fi

  # Job names are RFC 1123 subdomains - no underscores allowed, and two
  # of the real db names have one (cloudflare_tf, unifi_tf). Confirmed
  # live 2026-08-12: this broke on the very first real (non-dry-run)
  # restore attempted - dry-run mode returns before ever reaching this
  # line, so the bug was invisible until an actual restore ran.
  local job_name="postgres-restore-$(echo "${target}" | tr '_' '-')-$(date +%s)"
  cat <<EOF | kubectl apply -f -
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: postgres
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 900
  template:
    spec:
      restartPolicy: Never
      nodeSelector:
        kubernetes.io/hostname: k8smaster
      securityContext:
        runAsUser: 70
        runAsGroup: 70
      containers:
        - name: postgres-restore
          image: postgres:16.9-alpine
          command: ["/bin/sh", "-c", "${precreate} pg_restore --clean --if-exists -h postgres.postgres.svc.cluster.local -U postgres -d ${target} /mnt/backup/active_backup/postgres/${relpath}"]
          env:
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-superuser
                  key: POSTGRES_PASSWORD
          volumeMounts:
            - name: backup
              mountPath: /mnt/backup
      volumes:
        - name: backup
          hostPath:
            path: /mnt/backup
            type: Directory
EOF
  echo "    waiting for ${job_name}..."
  kubectl wait --for=condition=complete "job/${job_name}" -n postgres --timeout=600s
  kubectl logs "job/${job_name}" -n postgres
  kubectl delete "job/${job_name}" -n postgres
}

restore_postgres_globals() {
  local dryrun="$1"
  local file
  file=$(glob_list "$POSTGRES_BACKUP_DIR/daily/globals-*.sql.gz" | sort -r | head -1)
  if [ -z "$file" ]; then
    echo "No globals backup found - skipping role restore" >&2
    return 0
  fi
  local relpath="${file#"$POSTGRES_BACKUP_DIR"/}"
  echo "[*] globals (roles) <- $relpath"
  if [ "$dryrun" = "1" ]; then
    echo "    (dry-run) would run a Job: gunzip -c ... | psql -h postgres.postgres.svc.cluster.local -U postgres"
    return 0
  fi

  local job_name="postgres-restore-globals-$(date +%s)"  # no underscores in "globals" but kept consistent with the db-name path above
  cat <<EOF | kubectl apply -f -
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: postgres
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 300
  template:
    spec:
      restartPolicy: Never
      nodeSelector:
        kubernetes.io/hostname: k8smaster
      securityContext:
        runAsUser: 70
        runAsGroup: 70
      containers:
        - name: globals-restore
          image: postgres:16.9-alpine
          command: ["/bin/sh", "-c", "gunzip -c /mnt/backup/active_backup/postgres/${relpath} | psql -h postgres.postgres.svc.cluster.local -U postgres"]
          env:
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-superuser
                  key: POSTGRES_PASSWORD
          volumeMounts:
            - name: backup
              mountPath: /mnt/backup
      volumes:
        - name: backup
          hostPath:
            path: /mnt/backup
            type: Directory
EOF
  echo "    waiting for ${job_name}..."
  kubectl wait --for=condition=complete "job/${job_name}" -n postgres --timeout=300s
  kubectl logs "job/${job_name}" -n postgres
  kubectl delete "job/${job_name}" -n postgres
}

cmd_postgres() {
  local db="all" dryrun=0 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dryrun=1 ;;
      --to) shift; target="$1" ;;
      *) db="$1" ;;
    esac
    shift
  done

  if [ -n "$target" ] && [ "$db" = "all" ]; then
    echo "--to needs a single database name, not 'all'" >&2
    exit 1
  fi

  if [ "$db" = "all" ]; then
    if [ "$dryrun" != "1" ]; then
      confirm "This will overwrite ALL 7 live databases with their newest backups." || { echo "Aborted."; exit 1; }
    fi
    restore_postgres_globals "$dryrun"
    while IFS= read -r name; do
      restore_one_postgres_db "$name" "$dryrun"
    done <<< "$(postgres_db_names)"
  else
    if [ -z "$target" ] && [ "$dryrun" != "1" ]; then
      confirm "This will overwrite the live '$db' database with its newest backup." || { echo "Aborted."; exit 1; }
    fi
    restore_one_postgres_db "$db" "$dryrun" "${target:-$db}"
  fi
}

# --- sealed-secrets ------------------------------------------------------
# Only stages the file onto local disk - the actual kubectl-apply-into-
# kube-system step already exists and is tested
# (roles/apply_bootstrap/tasks/restore_sealed_secrets_key.yml), no
# reason to duplicate that logic here. This role's job is filling the
# gap that task doesn't cover: getting the QNAP's copy back onto local
# disk in the first place, for the real disaster scenario where
# k8smaster's own disk is what's gone.
cmd_sealed_secrets() {
  local dryrun=0
  [ "${1:-}" = "--dry-run" ] && dryrun=1

  local key
  key=$(glob_list "$CREDENTIALS_BACKUP_DIR/sealed-secrets-key-*.yaml" | sort -r | head -1)
  if [ -z "$key" ]; then
    echo "No sealed-secrets key backup found in $CREDENTIALS_BACKUP_DIR" >&2
    exit 1
  fi
  echo "[*] newest key: $(basename "$key")"
  if [ "$dryrun" = "1" ]; then
    echo "    (dry-run) would copy to $LOCAL_CREDENTIALS_DIR/"
    return 0
  fi
  mkdir -p "$LOCAL_CREDENTIALS_DIR"
  cp "$key" "$LOCAL_CREDENTIALS_DIR/"
  echo "Staged. Run the existing restore task to actually apply it:"
  echo "  ansible-playbook day0-infra-build.yml --tags install_day0"
  echo "(restore_sealed_secrets_key.yml runs as part of apply_bootstrap - it picks up whatever's newest in credentials/ automatically)"
}

# --- qnap-data -----------------------------------------------------------
# Plain rsync between two paths already mounted on k8smaster (the
# snapshot's read side, the live export's write side) - no cluster
# interaction needed at all for this one. Deliberately no --delete: a
# restore should add back what's missing, not force an exact mirror
# that could remove something live that's newer than the chosen
# generation.
cmd_qnap_data() {
  local source="${1:-}" date="" dryrun=0 target=""
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dryrun=1 ;;
      --to) shift; target="$1" ;;
      *) date="$1" ;;
    esac
    shift
  done

  if [ -z "$source" ] || [ -z "${RESTORE_TARGETS[$source]+x}" ]; then
    echo "Usage: restore.sh qnap-data <source> [date] [--to <path>] [--dry-run]" >&2
    echo "Known sources: ${!RESTORE_TARGETS[*]}" >&2
    exit 1
  fi

  if [ -z "$date" ]; then
    date=$(ls -1t "$QNAP_SNAPSHOT_DIR/daily" 2>/dev/null | head -1)
  fi
  local src_dir="$QNAP_SNAPSHOT_DIR/daily/$date/$source"
  local dest_dir="${target:-${RESTORE_TARGETS[$source]}}"

  if [ ! -d "$src_dir" ]; then
    echo "No snapshot found at $src_dir" >&2
    exit 1
  fi

  echo "[*] $source <- $src_dir"
  echo "    ->  $dest_dir$([ -n "$target" ] && echo " (scratch target, not the live export)")"
  if [ "$dryrun" = "1" ]; then
    # rsync piped straight into head risks SIGPIPE on a large source
    # (e.g. books' 152,028 files) once head closes early - pipefail
    # would then treat that as a pipeline failure. Explicitly ignored.
    { rsync -a --dry-run --itemize-changes "$src_dir/" "$dest_dir/" | head -20; } || true
    echo "    (dry-run - showing first 20 changes rsync would make)"
    return 0
  fi

  if [ -z "$target" ]; then
    confirm "This will restore '$source' from the $date snapshot onto the live export ($dest_dir)." || { echo "Aborted."; exit 1; }
  else
    mkdir -p "$dest_dir"
  fi
  rsync -a "$src_dir/" "$dest_dir/"
  echo "Done."
}

# --- entry point -----------------------------------------------------

# --- ssh keys -------------------------------------------------------------
# A rebuilt controller has no SSH keys, and group_vars/qnap.yml points
# ansible_ssh_private_key_file at ~/.ssh/qnap_ansible_ed25519. Without
# this, every QNAP-targeting play fails at connection time and the QNAP
# half of the rebuild simply cannot run. Keys reach the QNAP through the
# nightly credentials/ rsync in roles/qnap_client.
cmd_ssh_keys() {
  local dryrun="" src="{{ credentials_backup_dir }}/ssh" dest="$HOME/.ssh"
  [ "${1:-}" = "--dry-run" ] && dryrun=1
  if [ ! -d "$src" ]; then
    echo "No SSH key backup at $src" >&2; return 1
  fi
  local n=0
  for f in "$src"/*; do
    [ -e "$f" ] || continue
    local base; base="$(basename "$f")"
    if [ -n "$dryrun" ]; then
      echo "would restore $base -> $dest/$base"
    else
      mkdir -p "$dest"; chmod 700 "$dest"
      cp -p "$f" "$dest/$base"
      case "$base" in *.pub) chmod 644 "$dest/$base" ;; *) chmod 600 "$dest/$base" ;; esac
    fi
    n=$((n+1))
  done
  echo "${dryrun:+would restore }${n} SSH key file(s)"
}

# --- adhoc manifests ------------------------------------------------------
# day2-services/adhoc/ holds manifests that are real and applied but
# deliberately outside every ArgoCD sync path - currently the
# immich-tagging SealedSecret, which is sealed for the default namespace
# because the ad-hoc Jobs that consume it live there. Nothing syncs these,
# so a rebuild must apply them explicitly.
cmd_adhoc() {
  local dryrun="" dir="$HOME/gm-dev/day2-services/adhoc"
  [ "${1:-}" = "--dry-run" ] && dryrun=1
  if [ ! -d "$dir" ]; then
    echo "No adhoc directory at $dir" >&2; return 1
  fi
  local n=0
  for f in "$dir"/*.yml "$dir"/*.yaml; do
    [ -e "$f" ] || continue
    if [ -n "$dryrun" ]; then echo "would apply $(basename "$f")"
    else kubectl apply -f "$f" || return 1
    fi
    n=$((n+1))
  done
  echo "${dryrun:+would apply }${n} adhoc manifest(s)"
}

case "${1:-}" in
  list) cmd_list ;;
  postgres) shift; cmd_postgres "$@" ;;
  sealed-secrets) shift; cmd_sealed_secrets "$@" ;;
  qnap-data) shift; cmd_qnap_data "$@" ;;
  ssh-keys) shift; cmd_ssh_keys "$@" ;;
  adhoc) shift; cmd_adhoc "$@" ;;
  *) usage; exit 1 ;;
esac
