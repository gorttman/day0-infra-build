#!/bin/bash
# Rendered on the control host, executed on the QNAP by the script module
# (no Python needed there). Writes the shipper only when it differs, so a
# second Ansible run reports no change.
set -e
mkdir -p "$(dirname {{ qnap_log_shipper_script_path }})" {{ qnap_log_shipper_state_dir }}
new=$(mktemp)
cat > "$new" <<'QNAP_LOG_SHIPPER_EOF'
#!/bin/bash
# Generated by day0-infra-build roles/qnap_log_shipper - edits here are
# overwritten on the next Ansible run; edit variables/play/qnap_log_shipper.yml.
#
# Sends lines appended to the listed files since the last run to the
# cluster's syslog receiver. Offsets live in {{ qnap_log_shipper_state_dir }};
# the first run for a file starts at its current end (no history flood).
HOST={{ qnap_log_shipper_target_host }}
PORT={{ qnap_log_shipper_target_port }}
STATE={{ qnap_log_shipper_state_dir }}
MAXLINES={{ qnap_log_shipper_max_lines_per_run }}
tmp=$(mktemp)
trap 'rm -f "$tmp" "$tmp".*' EXIT
NOW=$(date +%s)
TS=$(date '+%b %e %H:%M:%S')

# BusyBox tr on this QNAP mangles character ranges (it deleted digits), so
# control characters are stripped with sed instead.
send() {  # tag message
  printf '<14>%s qnap %s: %s' "$TS" "$1" "${2:0:900}" > /dev/udp/$HOST/$PORT
}

# Send every line of a file, prefixing each with $2 (may be empty).
send_file() {  # tag file prefix
  while IFS= read -r line; do
    case "$line" in *[![:space:]]*) send "$1" "$3$line" ;; esac   # skip blank/padding lines
  done < "$2"
}

# Lines appended to a file since the last run. startat0=1 begins at byte 0 on
# the first run (history), otherwise the first run starts at the current end.
ship() {  # tag file [startat0] [prefix] [state-name]
  local tag=$1 file=$2 start0=${3:-0} prefix=${4:-} sf="$STATE/${5:-$1}" size off n consumed
  [ -f "$file" ] || return 0
  size=$(wc -c < "$file")
  off=$(cat "$sf" 2>/dev/null)
  if [ -z "$off" ]; then
    if [ "$start0" = 1 ]; then off=0; else echo "$size" > "$sf"; return 0; fi
  fi
  [ "$size" -lt "$off" ] && off=0            # truncated or rotated
  [ "$size" -eq "$off" ] && return 0
  tail -c +$((off + 1)) "$file" | tr -d '\000' | LC_ALL=C sed 's/[^ -~]//g' | head -n "$MAXLINES" > "$tmp"
  n=$(wc -l < "$tmp")                         # complete lines only
  [ "$n" -gt 0 ] || return 0
  head -n "$n" "$tmp" > "$tmp.c"
  send_file "$tag" "$tmp.c" "$prefix"
  # offsets count raw bytes; tr removed some, so measure on the raw stream
  consumed=$(tail -c +$((off + 1)) "$file" | head -n "$n" | wc -c)
  echo $((off + consumed)) > "$sf"
}

# Kernel ring (dmesg, non-destructive). New lines only, by kernel timestamp;
# a timestamp beyond current uptime means the box rebooted, so start again.
# The bookmark is the highest timestamp SEEN, not the last line sent: printk
# timestamps are not strictly in order inside the ring, and a last-line
# bookmark re-sent lines (found in testing). No per-run cap - the ring is
# about 2000 lines.
# boot=<epoch> lets the reader compute wall time = boot + [seconds].
ship_kernel() {
  local sf="$STATE/{{ qnap_log_shipper_kernel_tag }}" up boot last
  up=$(cut -d. -f1 /proc/uptime); boot=$((NOW - up))
  last=$(cat "$sf" 2>/dev/null); [ -n "$last" ] || last=-1
  dmesg | tr -d '\000' | LC_ALL=C sed 's/[^ -~]//g' | awk -v last="$last" -v up="$up" -v out="$sf.new" '
    BEGIN { if (last + 0 > up + 5) last = -1 }
    substr($0, 1, 1) == "[" && (i = index($0, "]")) > 2 {
      tss = substr($0, 2, i - 2); ts = tss + 0
      if (ts > last + 0) { print; n++ }
      if (ts > mx + 0) { mx = ts; mxs = tss }   # keep the text: awk prints numbers with 6 digits
    }
    END { if (n) printf "%s", mxs > out }' > "$tmp.k"
  [ -s "$tmp.k" ] || return 0
  send_file {{ qnap_log_shipper_kernel_tag }} "$tmp.k" "boot=$boot "
  mv "$sf.new" "$sf"
}

# QTS event log: a binary file with text records "YYYY-MM-DD" "HH:MM:SS"
# user ip host message. Sorted oldest first; only records newer than the last
# one shipped. The record's own date stays in the text (arrival time is not
# event time), so the first run ships the full history.
ship_events() {
  local f={{ qnap_log_shipper_event_log }} sf="$STATE/{{ qnap_log_shipper_event_tag }}" last
  [ -f "$f" ] || return 0
  last=$(cat "$sf" 2>/dev/null)
  strings -n 12 "$f" \
    | grep -aoE '20[0-9]{2}-[0-9]{2}-[0-9]{2}[0-9]{2}:[0-9]{2}:[0-9]{2}[A-Za-z]+[0-9.]+[A-Za-z0-9_-]+.*' \
    | sed -E 's/^(20[0-9]{2}-[0-9]{2}-[0-9]{2})([0-9]{2}:[0-9]{2}:[0-9]{2})/\1 \2 /; s/0[a-z]$//' \
    | sort \
    | awk -v last="$last" -v max="$MAXLINES" -v out="$sf.new" '
        { ts = substr($0, 1, 19); if (ts > last && n < max) { print; n++; lt = ts } }
        END { if (n) printf "%s", lt > out }' > "$tmp.e"
  [ -s "$tmp.e" ] || return 0
  send_file {{ qnap_log_shipper_event_tag }} "$tmp.e" ""
  mv "$sf.new" "$sf"
}

# One health line a minute: enough to see an NFS server stall or restart later.
sample_nfsd() {
  local up load conns
  up=$(cut -d. -f1 /proc/uptime)
  load=$(cut -d' ' -f1 /proc/loadavg)
  conns=$(awk '$2 ~ /:0801$/ && $4 == "01"' /proc/net/tcp 2>/dev/null | wc -l)
  send {{ qnap_log_shipper_nfsd_tag }} "$(awk -v up="$up" -v load="$load" -v conns="$conns" '
    FILENAME == "/proc/meminfo" { if ($1 == "MemFree:") mf = $2; if ($1 == "Cached:") ca = $2; next }
    $1 == "th" { th = $2 } $1 == "rc" { h = $2; m = $3 }
    $1 == "io" { r = $2; w = $3 } $1 == "rpc" { c = $2; b = $3 }
    END { printf "uptime=%s load1=%s memfree_kb=%s cached_kb=%s nfsd_threads=%s nfs_conns=%s rc_hits=%s rc_misses=%s io_read_bytes=%s io_write_bytes=%s rpc_calls=%s rpc_bad=%s", up, load, mf, ca, th, conns, h, m, r, w, c, b }
  ' /proc/meminfo /proc/net/rpc/nfsd)"
}

{% for f in qnap_log_shipper_files %}
ship {{ f.tag }} {{ f.path }}
{% endfor %}
ship_kernel
ship_events
sample_nfsd
{% for f in qnap_log_shipper_backfill_files %}
ship {{ f.tag }} {{ f.path }} 1 "src={{ f.src }} " {{ f.tag }}-{{ f.src }}
{% endfor %}

# Heartbeat every 10 minutes so a silent QNAP shows up as missing logs.
m=$(date +%M); m=${m#0}
[ $(( ${m:-0} % 10 )) -eq 0 ] && send qnap-log-shipper "alive files={{ qnap_log_shipper_files | length }}"
exit 0
QNAP_LOG_SHIPPER_EOF
chmod +x "$new"
if cmp -s "$new" {{ qnap_log_shipper_script_path }} 2>/dev/null; then
  rm -f "$new"; echo UNCHANGED
else
  mv "$new" {{ qnap_log_shipper_script_path }}; echo UPDATED
fi
