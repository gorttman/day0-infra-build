#!/bin/bash
# Rendered on the control host, executed on the QNAP by the script module
# (no Python needed there). Writes the shipper only when it differs, so a
# second Ansible run reports no change.
set -e
mkdir -p "$(dirname {{ qnap_log_shipper_script_path }})" {{ qnap_log_shipper_state_dir }}
new=$(mktemp)
cat > "$new" <<'QNAP_LOG_SHIPPER_EOF'
#!/bin/bash
# Generated by day0-infra-build roles/qnap_log_shipper - edits here are
# overwritten on the next Ansible run; edit variables/play/qnap_log_shipper.yml.
#
# Sends lines appended to the listed files since the last run to the
# cluster's syslog receiver. Offsets live in {{ qnap_log_shipper_state_dir }};
# the first run for a file starts at its current end (no history flood).
HOST={{ qnap_log_shipper_target_host }}
PORT={{ qnap_log_shipper_target_port }}
STATE={{ qnap_log_shipper_state_dir }}
MAXLINES={{ qnap_log_shipper_max_lines_per_run }}
tmp=$(mktemp)
trap 'rm -f "$tmp" "$tmp.c"' EXIT

send() {  # tag message
  printf '<14>%s qnap %s: %s' "$(date '+%b %e %H:%M:%S')" "$1" "${2:0:900}" > /dev/udp/$HOST/$PORT
}

ship() {  # tag file
  local tag=$1 file=$2 sf="$STATE/$1" size off n consumed
  [ -f "$file" ] || return 0
  size=$(wc -c < "$file")
  off=$(cat "$sf" 2>/dev/null)
  if [ -z "$off" ]; then echo "$size" > "$sf"; return 0; fi
  [ "$size" -lt "$off" ] && off=0            # truncated or rotated
  [ "$size" -eq "$off" ] && return 0
  tail -c +$((off + 1)) "$file" | head -n "$MAXLINES" > "$tmp"
  n=$(wc -l < "$tmp")                         # complete lines only
  [ "$n" -gt 0 ] || return 0
  head -n "$n" "$tmp" > "$tmp.c"
  consumed=$(wc -c < "$tmp.c")
  while IFS= read -r line; do
    [ -n "$line" ] && send "$tag" "$line"
  done < "$tmp.c"
  echo $((off + consumed)) > "$sf"
}

{% for f in qnap_log_shipper_files %}
ship {{ f.tag }} {{ f.path }}
{% endfor %}

# Heartbeat every 10 minutes so a silent QNAP shows up as missing logs.
m=$(date +%M); m=${m#0}
[ $(( ${m:-0} % 10 )) -eq 0 ] && send qnap-log-shipper "alive files={{ qnap_log_shipper_files | length }}"
exit 0
QNAP_LOG_SHIPPER_EOF
chmod +x "$new"
if cmp -s "$new" {{ qnap_log_shipper_script_path }} 2>/dev/null; then
  rm -f "$new"; echo UNCHANGED
else
  mv "$new" {{ qnap_log_shipper_script_path }}; echo UPDATED
fi
