apiVersion: batch/v1
kind: Job
metadata:
  name: {{ cloudflare_tf_job_name }}
  namespace: {{ cloudflare_tf_namespace }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 600
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: terraform
          image: {{ cloudflare_tf_image }}
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -euo pipefail
              cp -r /workspace-ro/. /workspace/
              cd /workspace
              terraform init -input=false -backend-config="conn_str=${TF_BACKEND_PG_CONN_STR}"
              terraform plan -input=false -no-color -out=tfplan | tee plan.txt

              # Fingerprint of the rendered plan (not the refresh noise), so
              # an apply run can prove it is applying what was reviewed.
              plan_sha=$(terraform show -no-color tfplan | sha256sum | cut -c1-16)
              echo "PLAN_SHA=${plan_sha}"

              destroy_count=$(sed -n 's/^Plan: .*, \([0-9]\{1,\}\) to destroy\..*/\1/p' plan.txt)
              destroy_count=${destroy_count:-0}
              if [ "${destroy_count}" -gt 0 ] && [ "${CLOUDFLARE_TF_ALLOW_DESTROY:-false}" != "true" ]; then
                echo "REFUSING TO APPLY: plan would destroy ${destroy_count} resource(s)." >&2
                echo "If intended, re-run with -e cloudflare_tf_allow_destroy=true." >&2
                exit 1
              fi

              if [ "${CLOUDFLARE_TF_DO_APPLY:-false}" != "true" ]; then
                echo "=== PLAN-ONLY RUN - nothing changed ==="
                exit 0
              fi

              if [ "${CLOUDFLARE_TF_APPROVED_PLAN:-}" != "${plan_sha}" ]; then
                echo "REFUSING TO APPLY: this plan is ${plan_sha}, you approved '${CLOUDFLARE_TF_APPROVED_PLAN:-}'." >&2
                echo "Something changed since you reviewed it. Re-run plan-only and review again." >&2
                exit 1
              fi

              terraform apply -input=false tfplan
              echo "=== APPLIED ${plan_sha} ==="
          envFrom:
            - secretRef:
                name: {{ cloudflare_tf_secret_name }}
          env:
            - name: CLOUDFLARE_TF_ALLOW_DESTROY
              value: "{{ cloudflare_tf_allow_destroy | string | lower }}"
            - name: CLOUDFLARE_TF_DO_APPLY
              value: "{{ cloudflare_tf_do_apply | string | lower }}"
            - name: CLOUDFLARE_TF_APPROVED_PLAN
              value: "{{ cloudflare_tf_approved_plan }}"
          volumeMounts:
            - name: tf-config-ro
              mountPath: /workspace-ro
              readOnly: true
            - name: tf-workspace
              mountPath: /workspace
      volumes:
        - name: tf-config-ro
          configMap:
            name: {{ cloudflare_tf_configmap_name }}
        - name: tf-workspace
          # This node's default emptyDir is NFS-backed (local_lock=none),
          # which fails flock() with ENOLCK - Terraform's state locking needs
          # real file locks even with the pg backend. medium: Memory (tmpfs)
          # avoids it. The cloudflare provider binary alone is ~228Mi, so
          # 512Mi leaves headroom for plan and state files.
          emptyDir:
            medium: Memory
            sizeLimit: 512Mi
