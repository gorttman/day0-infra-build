#!/bin/bash
# Read-only nightly drift check for the Terraform-managed stacks and the QNAP
# NFS exports.
#
# Runs each stack's plan-only play, counts resources whose plan is not empty
# and not on the known-benign list, and writes the result to InfluxDB
# (measurement infra_drift) so Grafana can alert. Never applies anything:
# the plays default to plan-only and this script never passes the apply flags.
#
# Known-benign entries live in /etc/infra-drift-known.txt, one per line:
#   <stack> <terraform resource address>
set -u
REPO=/home/gorttman/gm-dev/day0-infra-build
KNOWN=/etc/infra-drift-known.txt
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
cd "$REPO" || exit 1

token=$(kubectl -n monitoring get secret telegraf-influxdb -o jsonpath='{.data.INFLUX_TOKEN}' | base64 -d) || exit 1
influx=$(kubectl -n monitoring get svc influxdb -o jsonpath='{.spec.clusterIP}') || exit 1
[ -n "$token" ] && [ -n "$influx" ] || { echo "cannot find InfluxDB token or address" >&2; exit 1; }

now=$(date +%s)
lines=""
for pair in cloudflare:cloudflare-tf-apply.yml unifi:unifi-tf-apply.yml; do
  stack=${pair%%:*}
  play=${pair#*:}
  out=$(ansible-playbook "$play" 2>&1)
  rc=$?
  clean=$(printf '%s\n' "$out" | tr -d '\\')
  check_ok=0
  if [ $rc -eq 0 ] && printf '%s\n' "$clean" | grep -qE 'Plan: |No changes'; then
    check_ok=1
  fi
  drifted=0
  benign=0
  while read -r addr; do
    [ -n "$addr" ] || continue
    if grep -qxF "$stack $addr" "$KNOWN" 2>/dev/null; then
      benign=$((benign + 1))
    else
      drifted=$((drifted + 1))
      echo "DRIFT $stack: $addr"
    fi
  done < <(printf '%s\n' "$clean" | sed -n 's/.*# \([^ ]*\) \(will be\|must be\).*/\1/p' | sort -u)
  echo "$stack: check_ok=$check_ok drifted=$drifted benign=$benign (play rc=$rc)"
  lines+="infra_drift,stack=$stack drifted=${drifted}i,benign=${benign}i,check_ok=${check_ok}i ${now}"$'\n'
done

# QNAP NFS exports: check mode runs only read-only probes (grep/exportfs -v) over
# ssh - a few tiny commands, nothing that writes or restarts NFS. Prints
# "DRIFT qnap_exports: ..." or "NO DRIFT qnap_exports".
# The QNAP ssh key and known_hosts belong to the repo owner, not root (the
# inventory uses ~/.ssh/qnap_ansible_ed25519), so run this one as that user.
owner=$(stat -c %U "$REPO")
if [ "$(id -u)" = 0 ] && [ "$owner" != root ]; then
  out=$(runuser -u "$owner" -- env HOME="$(getent passwd "$owner" | cut -d: -f6)" ansible-playbook qnap-manage.yml --check --tags manage_qnap_exports 2>&1)
else
  out=$(ansible-playbook qnap-manage.yml --check --tags manage_qnap_exports 2>&1)
fi
rc=$?
clean=$(printf '%s\n' "$out" | tr -d '\\')
check_ok=0
drifted=0
if [ $rc -eq 0 ] && printf '%s\n' "$clean" | grep -q 'NO DRIFT qnap_exports'; then
  check_ok=1
elif [ $rc -eq 0 ] && printf '%s\n' "$clean" | grep -q 'DRIFT qnap_exports:'; then
  check_ok=1
  msg=$(printf '%s\n' "$clean" | grep -o 'DRIFT qnap_exports:[^"]*' | head -1)
  drifted=$(printf '%s' "$msg" | sed 's/^DRIFT qnap_exports://' | tr ';' '\n' | grep -c '[^ ]')
  echo "$msg"
fi
echo "qnap_exports: check_ok=$check_ok drifted=$drifted benign=0 (play rc=$rc)"
lines+="infra_drift,stack=qnap_exports drifted=${drifted}i,benign=0i,check_ok=${check_ok}i ${now}"$'\n'

code=$(printf '%s' "$lines" | curl -s -o /dev/null -w '%{http_code}' -XPOST \
  "http://${influx}:8086/api/v2/write?org=pilab&bucket=telegraf&precision=s" \
  -H "Authorization: Token ${token}" --data-binary @-)
echo "influx write: HTTP $code"
[ "$code" = "204" ]
