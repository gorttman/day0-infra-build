apiVersion: batch/v1
kind: Job
metadata:
  name: {{ unifi_tf_job_name }}
  namespace: {{ unifi_tf_namespace }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 600
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: terraform
          image: hashicorp/terraform:1.9.8
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -euo pipefail
              cp -r /workspace-ro/. /workspace/
              cd /workspace
              terraform init -input=false -backend-config="conn_str=${TF_BACKEND_PG_CONN_STR}"
              terraform plan -input=false -no-color -out=tfplan | tee plan.txt

              # Same destroy-guard as the original ArgoCD-hook Job
              # (day1-foundation HISTORY.md #5, now HISTORY.md in this
              # role) - preserved exactly, just triggered by a human
              # running this playbook instead of an automated sync.
              destroy_count=$(sed -n 's/^Plan: .*, \([0-9]\{1,\}\) to destroy\..*/\1/p' plan.txt)
              destroy_count=${destroy_count:-0}
              if [ "${destroy_count}" -gt 0 ] && [ "${UNIFI_TF_ALLOW_DESTROY:-false}" != "true" ]; then
                echo "REFUSING TO APPLY: plan would destroy ${destroy_count} resource(s)." >&2
                echo "Review the plan above. If the destroy is genuinely intended," >&2
                echo "re-run with -e unifi_tf_allow_destroy=true." >&2
                exit 1
              fi

              if [ "${UNIFI_TF_DO_APPLY:-false}" != "true" ]; then
                echo "=== PLAN-ONLY RUN - re-run with -e unifi_tf_do_apply=true to actually apply ==="
                exit 0
              fi

              terraform apply -input=false tfplan
          envFrom:
            - secretRef:
                name: unifi-tf-secrets
          env:
            - name: UNIFI_TF_ALLOW_DESTROY
              value: "{{ unifi_tf_allow_destroy | string | lower }}"
            - name: UNIFI_TF_DO_APPLY
              value: "{{ unifi_tf_do_apply | string | lower }}"
          volumeMounts:
            - name: tf-config-ro
              mountPath: /workspace-ro
              readOnly: true
            - name: tf-workspace
              mountPath: /workspace
      volumes:
        - name: tf-config-ro
          configMap:
            name: {{ unifi_tf_configmap_name }}
        - name: tf-workspace
          # Same NFS/flock issue as cloudflare-tf/the original unifi-tf
          # Job: this node's default emptyDir is NFS-backed
          # (local_lock=none), which fails flock() with ENOLCK -
          # Terraform's state locking needs real file locks even with
          # the pg backend. medium: Memory avoids it.
          emptyDir:
            medium: Memory
            sizeLimit: 512Mi
